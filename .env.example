# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# OpenAI / Vocareum API key
OPENAI_API_KEY=
# Vocareum base URL (or leave blank to use api.openai.com/v1)
OPENAI_BASE_URL=https://openai.vocareum.com/v1

# Model override (default: gpt-4o)
# FANTASY_GM_MODEL=gpt-4o

# ESPN private league auth
# Get these from browser DevTools → Application → Cookies → fantasy.espn.com
ESPN_SWID=
ESPN_S2=

# Your league and team
ESPN_LEAGUE_ID=1660218687
ESPN_TEAM_ID=8
ESPN_SEASON=2025
