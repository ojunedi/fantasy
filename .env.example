# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# LLM backend: "anthropic" (default), "google", or "groq".
FANTASY_GM_PROVIDER=anthropic

# --- Anthropic (default) ---------------------------------------------------
# Use a WORKSPACE-SCOPED key; an org-level key is rejected unless you also set
# ANTHROPIC_WORKSPACE_ID below.
ANTHROPIC_API_KEY=
# Model ids here are never date-suffixed.
FANTASY_GM_ANTHROPIC_MODEL=claude-haiku-4-5
# Only needed if your key is NOT workspace-scoped.
# ANTHROPIC_WORKSPACE_ID=

# --- Alternative providers (optional) --------------------------------------
# GOOGLE_API_KEY=
# FANTASY_GM_MODEL=gemini-2.5-flash        # google only — ignored by others
# GROQ_API_KEY=
# FANTASY_GM_GROQ_MODEL=qwen/qwen3.8-27b

# --- Agent limits (sensible defaults per provider; override to tune) --------
# Max LLM calls per run — the agent loop and LLM sub-agents share this budget.
FANTASY_GM_MAX_LLM_CALLS=8
# FANTASY_GM_MAX_RPM=            # requests/minute ceiling
# FANTASY_GM_MAX_TOKENS=         # completion tokens per call
# FANTASY_GM_TRACE=full          # untruncated tool output in the trace

# ESPN private league auth
# Get these from browser DevTools → Application → Cookies → fantasy.espn.com
ESPN_SWID=
ESPN_S2=

# Your league and team
ESPN_LEAGUE_ID=1660218687
ESPN_TEAM_ID=8
ESPN_SEASON=2026
