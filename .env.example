# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# LLM backend: Google Gemini (via langchain-google-genai)
GOOGLE_API_KEY=

# Model (default: gemini-2.5-flash)
FANTASY_GM_MODEL=gemini-2.5-flash

# ESPN private league auth
# Get these from browser DevTools → Application → Cookies → fantasy.espn.com
ESPN_SWID=
ESPN_S2=

# Your league and team
ESPN_LEAGUE_ID=1660218687
ESPN_TEAM_ID=8
ESPN_SEASON=2025
